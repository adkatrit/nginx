<!doctype html>
<html lang="en" data-theme="neo">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070a18" />
    <title>Code from Dream | DeytaDreams — Stem-Reactive 3D Worlds</title>

    <!-- SEO Meta -->
    <meta name="description" content="Original music split into living pieces. Drums carve terrain, bass floods oceans, vocals paint atmosphere. Nine tracks asking what stays human when everything becomes signal." />
    <meta name="author" content="DeytaDreams" />
    <meta name="keywords" content="DeytaDreams, Code from Dream, audio visualization, music visualizer, 3D music, stem player, WebAudio, Three.js, immersive music, audio reactive, stem mixer, reggae electronic" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://jrod.dev/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jrod.dev/" />
    <meta property="og:title" content="Code from Dream — DeytaDreams" />
    <meta property="og:description" content="Reggae-infused electronic music pulled apart into stems and fed to a 3D world that listens back. Each instrument reshapes the landscape. What stays human when everything becomes signal?" />
    <meta property="og:image" content="https://jrod.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Code from Dream — 3D stem-reactive terrain with glowing equalizer bars" />
    <meta property="og:site_name" content="Code from Dream" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Code from Dream — DeytaDreams" />
    <meta name="twitter:description" content="Original music pulled apart into stems and fed to a 3D world that listens back. Drums carve terrain, bass floods oceans, vocals paint atmosphere." />
    <meta name="twitter:image" content="https://jrod.dev/og-image.png" />
    <meta name="twitter:image:alt" content="Code from Dream — 3D stem-reactive music visualization" />

    <!-- Structured Data: WebApplication -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Code from Dream",
      "url": "https://jrod.dev/",
      "description": "Original music pulled apart into stems and fed to a 3D world that listens back. Each instrument reshapes the landscape in real time. By DeytaDreams.",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "browserRequirements": "Requires JavaScript, WebAudio API, WebGL",
      "author": {
        "@type": "Person",
        "name": "DeytaDreams",
        "url": "https://jrod.dev/"
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "screenshot": "https://jrod.dev/og-image.png"
    }
    </script>

    <!-- Structured Data: MusicGroup -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "MusicGroup",
      "name": "DeytaDreams",
      "url": "https://jrod.dev/",
      "genre": ["Electronic", "Experimental"],
      "track": [
        { "@type": "MusicRecording", "name": "Terms & Conditions", "byArtist": { "@type": "MusicGroup", "name": "DeytaDreams" }, "url": "https://jrod.dev/" },
        { "@type": "MusicRecording", "name": "Data Tide", "byArtist": { "@type": "MusicGroup", "name": "DeytaDreams" }, "url": "https://jrod.dev/" },
        { "@type": "MusicRecording", "name": "Signal Integrity", "byArtist": { "@type": "MusicGroup", "name": "DeytaDreams" }, "url": "https://jrod.dev/" },
        { "@type": "MusicRecording", "name": "Trade You My Hands", "byArtist": { "@type": "MusicGroup", "name": "DeytaDreams" }, "url": "https://jrod.dev/" },
        { "@type": "MusicRecording", "name": "Turn Your Phone Face Down", "byArtist": { "@type": "MusicGroup", "name": "DeytaDreams" }, "url": "https://jrod.dev/" }
      ]
    }
    </script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NRQ96GQ70K"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NRQ96GQ70K');
    </script>

    <link rel="icon" href="./favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="./favicon.svg" />
    <link rel="apple-touch-icon" href="./favicon.svg" />
    <link rel="manifest" href="./site.webmanifest" />
    <!-- Preload critical assets -->
    <link rel="preload" href="./styles.css?v=24" as="style" />
    <link rel="preload" href="./app.js?v=28" as="script" />
    <link rel="preload" href="./track-scenes.js?v=36" as="script" />
    <link rel="preload" href="./environments.js?v=12" as="script" />

    <link rel="stylesheet" href="./styles.css?v=24" />

    <script type="importmap">
      {
        "imports": {
          "three": "https://cdn.jsdelivr.net/npm/three@0.182.0/build/three.webgpu.js",
          "three/webgpu": "https://cdn.jsdelivr.net/npm/three@0.182.0/build/three.webgpu.js",
          "three/tsl": "https://cdn.jsdelivr.net/npm/three@0.182.0/build/three.tsl.js",
          "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.182.0/examples/jsm/"
        }
      }
    </script>
  </head>
  <body>
    <noscript>
      <div class="noscript">
        <h1>Code from Dream &mdash; DeytaDreams</h1>
        <p>
          Original music pulled apart into stems and fed to a 3D world that listens back.
          Drums carve terrain, bass floods oceans, vocals paint atmosphere. Nine tracks
          asking what stays human when everything becomes signal.
        </p>
        <h2>Featured Tracks</h2>
        <ul>
          <li><strong>Terms &amp; Conditions</strong> &mdash; Digital dystopia with glass towers and holographic contracts</li>
          <li><strong>Data Tide</strong> &mdash; Underwater bioluminescent ocean with coral towers and jellyfish</li>
          <li><strong>Signal Integrity</strong> &mdash; Clean technical oscilloscope and data streams</li>
          <li><strong>Trade You My Hands</strong> &mdash; Metamorphosis and human-AI symbiosis</li>
          <li><strong>Turn Your Phone Face Down</strong> &mdash; Warm intimate space exploring human connection vs digital life</li>
        </ul>
        <h2>Features</h2>
        <ul>
          <li>Stem mixer &mdash; independently control drums, bass, vocals, synth, and guitar</li>
          <li>3D flight mode through audio-reactive environments</li>
          <li>Real-time lyrics overlay synchronized to music</li>
          <li>Score and combo system for interactive engagement</li>
          <li>MIDI-driven visual events for frame-perfect synchronization</li>
        </ul>
        <p>Please enable JavaScript to experience Code from Dream. Requires a modern browser with WebAudio API and WebGL support.</p>
      </div>
    </noscript>

    <!-- Full-screen background visualization -->
    <canvas id="bgViz" class="immersive-bg-viz" aria-hidden="true"></canvas>

    <!-- Track loading overlay -->
    <div id="loadingOverlay" class="loading-overlay" style="display: none;">
      <div class="loading-content">
        <div class="loading-spinner"></div>
        <div class="loading-title" id="loadingTitle">Loading Track</div>
        <div class="loading-progress">
          <div class="loading-bar">
            <div class="loading-bar-fill" id="loadingBarFill"></div>
          </div>
          <div class="loading-status" id="loadingStatus">Preparing...</div>
        </div>
      </div>
    </div>

    <!-- Score HUD overlay -->
    <div id="scoreHud" class="score-hud" aria-hidden="true">
      <div class="score-display">
        <span class="score-label">SCORE</span>
        <span class="score-value" id="scoreValue">0</span>
      </div>
      <div class="combo-display" id="comboDisplay">
        <div class="combo-line">
          <span class="combo-value" id="comboValue">1</span>
          <span class="combo-label">x COMBO</span>
        </div>
        <div class="flow-line">
          <span class="flow-label">FLOW</span>
          <span class="flow-value" id="flowValue">--%</span>
          <div class="flow-bar" aria-hidden="true">
            <div class="flow-bar__fill" id="flowBarFill"></div>
          </div>
          <span class="gate-label">GATES</span>
          <span class="gate-value" id="gateStreakValue">0</span>
        </div>
        <div class="tempo-line">
          <span class="tempo-label">BPM</span>
          <span class="tempo-value" id="bpmValue">--</span>
          <span class="tempo-label">APM</span>
          <span class="tempo-value" id="apmValue">0</span>
          <span class="rhythm-multiplier" id="rhythmMultiplier">x1.00</span>
          <span class="tempo-label">RHYTHM</span>
        </div>
      </div>
      <div class="high-score-display">
        <span class="high-score-label">HIGH</span>
        <span class="high-score-value" id="highScoreValue">0</span>
      </div>
    </div>

    <!-- Hit feedback overlay -->
    <div id="hitFeedback" class="hit-feedback" aria-hidden="true"></div>

    <!-- Audio Reactivity Panel -->
    <div id="stemDebugPanel" class="stem-debug-panel" hidden>
      <div class="stem-debug-header">
        <span class="stem-debug-title">AUDIO REACTIVITY</span>
        <a class="stem-debug-docs" href="./docs/audio-reactivity.html" target="_blank" title="How it works" aria-label="Documentation">?</a>
        <button class="stem-debug-copy" id="copyStemSettings" type="button" title="Copy settings to clipboard">COPY</button>
        <button class="stem-debug-close" id="closeStemDebug" type="button">&times;</button>
      </div>
      <div class="stem-debug-content" id="stemDebugContent">
        <!-- Populated dynamically -->
      </div>
    </div>

    <!-- Sun Effect Settings Panel -->
    <div id="sunSettingsPanel" class="stem-debug-panel" hidden>
      <div class="stem-debug-header">
        <span class="stem-debug-title">SUN EFFECT</span>
        <button class="stem-debug-close" id="closeSunSettings" type="button">&times;</button>
      </div>
      <div class="stem-debug-content" id="sunSettingsContent" style="display: flex; flex-direction: column; gap: 12px;">
        <label style="display: flex; align-items: center; gap: 8px;">
          <input type="checkbox" id="sunEnabledToggle" checked style="cursor: pointer;" />
          <span>Enable Sun</span>
        </label>

        <div>
          <label for="sunXSlider" style="display: block; font-size: 0.9em; margin-bottom: 4px;">
            X Position: <span id="sunXValue">50</span>%
          </label>
          <input type="range" id="sunXSlider" min="0" max="100" value="50" style="width: 100%;" />
        </div>

        <div>
          <label for="sunYSlider" style="display: block; font-size: 0.9em; margin-bottom: 4px;">
            Y Position: <span id="sunYValue">20</span>%
          </label>
          <input type="range" id="sunYSlider" min="0" max="100" value="20" style="width: 100%;" />
        </div>

        <div>
          <label for="sunSizeSlider" style="display: block; font-size: 0.9em; margin-bottom: 4px;">
            Size: <span id="sunSizeValue">60</span>px
          </label>
          <input type="range" id="sunSizeSlider" min="10" max="200" value="60" style="width: 100%;" />
        </div>

        <div>
          <label for="sunColorInput" style="display: block; font-size: 0.9em; margin-bottom: 4px;">
            Color:
          </label>
          <input type="color" id="sunColorInput" value="#FFD700" style="width: 60px; height: 30px; cursor: pointer;" />
        </div>

        <div>
          <label for="sunPulseSlider" style="display: block; font-size: 0.9em; margin-bottom: 4px;">
            Pulse Amount: <span id="sunPulseValue">30</span>%
          </label>
          <input type="range" id="sunPulseSlider" min="0" max="100" value="30" style="width: 100%;" />
        </div>

        <div>
          <label for="sunGlowSlider" style="display: block; font-size: 0.9em; margin-bottom: 4px;">
            Glow Intensity: <span id="sunGlowValue">60</span>%
          </label>
          <input type="range" id="sunGlowSlider" min="0" max="100" value="60" style="width: 100%;" />
        </div>
      </div>
    </div>

    <!-- End-of-run summary (Chill Ride) -->
    <div id="runSummary" class="run-summary" hidden>
      <div class="run-summary__card" role="status" aria-live="polite">
        <div class="run-summary__rank" id="runRank">B</div>
        <div class="run-summary__meta">
          <div class="run-summary__row">
            <span class="run-summary__label">FLOW AVG</span>
            <span class="run-summary__value" id="runFlowAvg">--%</span>
          </div>
          <div class="run-summary__row">
            <span class="run-summary__label">GATE ACC</span>
            <span class="run-summary__value" id="runGateAcc">--%</span>
          </div>
          <div class="run-summary__row">
            <span class="run-summary__label">MAX STREAK</span>
            <span class="run-summary__value" id="runGateStreakMax">0</span>
          </div>
        </div>
        <div class="run-summary__hint">Click to dismiss</div>
      </div>
    </div>

    <!-- High Score Entry Modal -->
    <div id="highScoreModal" class="high-score-modal" hidden>
      <div class="high-score-modal__content">
        <h2 class="high-score-modal__title" id="modalTitle">TRACK COMPLETE</h2>
        <div class="high-score-modal__score" id="finalScoreDisplay">0</div>
        <div class="high-score-modal__track" id="finalTrackDisplay"></div>
        <div class="high-score-modal__stats" id="finalStats">
          <div class="stat-row"><span class="stat-label">Rhythm Sync</span><span class="stat-val" id="finalSync">--</span></div>
          <div class="stat-row"><span class="stat-label">Beat Regularity</span><span class="stat-val" id="finalBeat">--</span></div>
          <div class="stat-row"><span class="stat-label">Rhythm Bonus</span><span class="stat-val" id="finalRhythmBonus">x1.00</span></div>
        </div>
        <div class="high-score-modal__input" id="initialsSection">
          <label>Enter your initials:</label>
          <input type="text" id="initialsInput" maxlength="3" placeholder="AAA" autocomplete="off" />
        </div>
        <div class="high-score-modal__buttons">
          <button id="saveScoreBtn" class="high-score-modal__btn">SAVE</button>
          <button id="nextTrackBtn" class="high-score-modal__btn">NEXT TRACK</button>
          <button id="skipScoreBtn" class="high-score-modal__btn high-score-modal__btn--skip">SKIP</button>
        </div>
        <div class="high-score-modal__leaderboard" id="leaderboardDisplay"></div>
      </div>
    </div>

    <!-- Screen reader announcements -->
    <div class="sr-only" role="status" aria-live="polite" id="ariaStatus"></div>

    <!-- Keyboard hints overlay -->
    <div class="keyboard-hints" aria-hidden="true">
      <div class="keyboard-hint keyboard-hint--movement">
        <div class="keyboard-hint__layout">
          <div class="keyboard-hint__row">
            <kbd class="kbd--wasd">W</kbd>
          </div>
          <div class="keyboard-hint__row">
            <kbd class="kbd--wasd">A</kbd>
            <kbd class="kbd--wasd">S</kbd>
            <kbd class="kbd--wasd">D</kbd>
          </div>
        </div>
        <span class="keyboard-hint__label">Flight</span>
      </div>
      <div class="keyboard-hint">
        <span class="keyboard-hint__keys">
          <kbd class="kbd--wide">Shift</kbd>
        </span>
        <span class="keyboard-hint__label">Fast Turn</span>
      </div>
      <div class="keyboard-hint">
        <span class="keyboard-hint__keys">
          <kbd class="kbd--wide">Space</kbd>
        </span>
        <span class="keyboard-hint__label">Boost</span>
      </div>
      <div class="keyboard-hint">
        <span class="keyboard-hint__keys">
          <kbd>F</kbd>
        </span>
        <span class="keyboard-hint__label">Metrics</span>
      </div>
    </div>

    <main id="app" class="immersive-app" aria-label="Audio Player">

      <!-- Lyrics Overlay -->
      <div id="lyricsOverlay" class="lyrics-overlay" aria-live="polite" aria-atomic="true">
        <div class="lyrics-overlay__section" id="lyricsSection"></div>
        <div class="lyrics-overlay__current" id="lyricsCurrent"></div>
        <div class="lyrics-overlay__next" id="lyricsNext"></div>
      </div>

      <!-- Floating Control Bar (2-row layout) -->
      <div class="control-bar" id="controlBar" role="region" aria-label="Playback controls">

        <!-- Row 1: Track Info | Stem Mixer | Volume/Playlist -->
        <div class="control-bar__row control-bar__row--top">
          <!-- Track Info -->
          <div class="control-bar__track">
            <div class="control-bar__cover" id="nowPlayingCover" aria-hidden="true"></div>
            <div class="control-bar__info">
              <div class="control-bar__title" id="trackTitle">No tracks loaded</div>
              <div class="control-bar__artist" id="trackArtist"></div>
            </div>
          </div>

          <!-- Stem Mixer -->
          <div class="stem-mixer" id="stemMixer" role="group" aria-label="Stem mixer">
            <button class="stem-btn" data-stem="drums" aria-pressed="true" title="Drums">
              <span class="stem-btn__icon">D</span>
              <div class="stem-btn__level"></div>
            </button>
            <button class="stem-btn" data-stem="bass" aria-pressed="true" title="Bass">
              <span class="stem-btn__icon">B</span>
              <div class="stem-btn__level"></div>
            </button>
            <button class="stem-btn" data-stem="vocals" aria-pressed="true" title="Vocals">
              <span class="stem-btn__icon">V</span>
              <div class="stem-btn__level"></div>
            </button>
            <button class="stem-btn" data-stem="synth" aria-pressed="true" title="Synth">
              <span class="stem-btn__icon">S</span>
              <div class="stem-btn__level"></div>
            </button>
            <button class="stem-btn" data-stem="guitar" aria-pressed="true" title="Guitar">
              <span class="stem-btn__icon">G</span>
              <div class="stem-btn__level"></div>
            </button>
          </div>

          <!-- Right Section -->
          <div class="control-bar__right">
            <div class="control-bar__volume">
              <button class="ctrl-btn ctrl-btn--sm" id="volumeBtn" type="button" aria-label="Mute" title="Volume">
                &#x1F50A;
              </button>
              <input id="volume" type="range" min="0" max="100" value="100" step="1" class="volume-slider" aria-label="Volume" />
            </div>
            <button class="ctrl-btn ctrl-btn--playlist" id="playlistBtn" type="button" aria-label="Open playlist" aria-expanded="false" title="Library">
              &#x2630;
            </button>
            <a class="ctrl-btn ctrl-btn--docs" href="./docs/audio-reactivity.html" target="_blank" aria-label="Documentation" title="How it works">
              ?
            </a>
            <button class="ctrl-btn ctrl-btn--sm ctrl-btn--fullscreen" id="fullscreenBtn" type="button" aria-label="Toggle fullscreen" title="Fullscreen">
              ⛶
            </button>
          </div>
        </div>

        <!-- Row 2: Playback Controls | Waveform -->
        <div class="control-bar__row control-bar__row--bottom">
          <!-- Playback Buttons -->
          <div class="control-bar__buttons">
            <button class="ctrl-btn ctrl-btn--sm" id="shuffleBtn" type="button" aria-label="Toggle shuffle" aria-pressed="false" title="Shuffle">
              &#x21C4;
            </button>
            <button class="ctrl-btn" id="prevBtn" type="button" aria-label="Previous track" title="Previous">
              &#x23EE;
            </button>
            <button class="ctrl-btn ctrl-btn--play" id="playPauseBtn" type="button" aria-label="Play" title="Play/Pause">
              &#x25B6;
            </button>
            <button class="ctrl-btn" id="nextBtn" type="button" aria-label="Next track" title="Next">
              &#x23ED;
            </button>
            <button class="ctrl-btn ctrl-btn--sm" id="repeatBtn" type="button" aria-label="Toggle repeat" aria-pressed="false" title="Repeat">
              &#x1F501;
            </button>
          </div>

          <!-- Waveform Progress -->
          <div class="control-bar__waveform">
            <span class="control-bar__time" id="currentTime">0:00</span>
            <div class="waveform-container" id="waveformContainer">
              <canvas id="waveformCanvas" class="waveform-canvas"></canvas>
              <input id="seek" type="range" min="0" max="1000" value="0" step="1" class="waveform-input" aria-label="Seek position" />
              <div class="waveform-playhead" id="waveformPlayhead"></div>
            </div>
            <span class="control-bar__time" id="duration">0:00</span>
          </div>
        </div>
      </div>

      <!-- Playlist Modal -->
      <div class="playlist-modal" id="playlistModal" role="dialog" aria-modal="true" aria-labelledby="playlistModalTitle" hidden>
        <div class="playlist-modal__backdrop" id="playlistBackdrop"></div>
        <div class="playlist-modal__content">
          <header class="playlist-modal__header">
            <h2 id="playlistModalTitle" class="playlist-modal__title">Library</h2>
            <div class="playlist-modal__actions">
              <button class="modal-btn" id="addBtn" type="button">ADD</button>
              <button class="modal-btn modal-btn--danger" id="clearBtn" type="button">CLR</button>
            </div>
            <button class="playlist-modal__close" id="closePlaylistBtn" type="button" aria-label="Close playlist">
              &#x2715;
            </button>
          </header>

          <div class="playlist-modal__search">
            <input id="filterInput" type="search" placeholder="Search tracks..." autocomplete="off" aria-label="Search tracks" />
            <input id="filePicker" type="file" accept="audio/*,.mp3,.wav,.ogg,.m4a,.aac,.flac" multiple hidden />
          </div>

          <ol class="playlist-modal__list wa-list" id="playlist" aria-label="Track list"></ol>

          <div class="playlist-modal__empty" id="emptyState">
            <div class="empty-icon">&#x266B;</div>
            <div class="empty-title">No tracks yet</div>
            <div class="empty-text">
              Drag audio files here, click ADD, or add tracks to <code>tracks.js</code>
            </div>
          </div>

          <div class="playlist-modal__dropzone" id="dropzone" aria-hidden="true">
            Drop audio files to add
          </div>
        </div>
      </div>

    </main>

    <!-- Keep a real media element in the DOM for best mobile behavior -->
    <audio id="playerAudio" preload="metadata" crossorigin="anonymous" playsinline style="display:none"></audio>

    <script src="./tracks.js?v=13"></script>
    <script src="./models.js?v=9"></script>
    <script src="./themes.js?v=13"></script>
    <script src="./backgrounds.js?v=10"></script>
    <script src="./track-scenes.js?v=36"></script>
    <script src="./effects-manager.js?v=10"></script>
    <script src="./noise.js?v=9"></script>
    <script src="./terrain.js?v=9"></script>
    <script src="./environments.js?v=12"></script>
    <script src="./stem-player.js?v=13"></script>
    <script src="./ios-viz.js?v=9"></script>
    <script src="./scene-tuner.js?v=4"></script>
    <script src="./app.js?v=28"></script>
  </body>
</html>
