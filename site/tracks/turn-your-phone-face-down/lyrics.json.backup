{
  "lyrics": [
    {
      "time": 44,
      "type": "section",
      "text": "[Verse 1]"
    },
    {
      "time": 45,
      "text": "You quote the news like it's the truth"
    },
    {
      "time": 47.8,
      "text": "Scroll the room with your eyes"
    },
    {
      "time": 50.6,
      "text": "Your friends fit inside your pocket"
    },
    {
      "time": 53.4,
      "text": "But no one truly knows your thoughts"
    },
    {
      "time": 56.2,
      "text": "You mention"
    },
    {
      "time": 59.0,
      "text": "\"Can you believe it?"
    },
    {
      "time": 61.8,
      "text": "Everything's on fire\""
    },
    {
      "time": 64.6,
      "text": "I’m just trying to ask you"
    },
    {
      "time": 67.4,
      "text": "What sparks your inner fire"
    },
    {
      "time": 70.2,
      "type": "section",
      "text": "[Chorus]"
    },
    {
      "time": 71.2,
      "text": "Turn your phone face down"
    },
    {
      "time": 74.0,
      "text": "Look at me right now"
    },
    {
      "time": 76.8,
      "text": "I’m tired of debating everything"
    },
    {
      "time": 79.6,
      "text": "And never speaking from the heart"
    },
    {
      "time": 82.4,
      "text": "I don’t need your latest view"
    },
    {
      "time": 85.2,
      "text": "I just need your honest point"
    },
    {
      "time": 88.0,
      "text": "Turn your phone face down"
    },
    {
      "time": 90.8,
      "text": "Can we be present now?"
    },
    {
      "time": 93.6,
      "type": "section",
      "text": "[Verse 2]"
    },
    {
      "time": 94.6,
      "text": "You bring stats like party tricks"
    },
