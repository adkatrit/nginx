{
  "lyrics": [
    {
      "time": 19,
      "type": "section",
      "text": "[Verse 1]"
    },
    {
      "time": 20,
      "text": "Mi nuh type long mail dem again"
    },
    {
      "time": 22.3,
      "text": "Smart likkle agent pree all a mi frien'"
    },
    {
      "time": 24.6,
      "text": "Push one button, calendar rearrange"
    },
    {
      "time": 26.9,
      "text": "Free up mi brain, now mi thoughts get strange"
    },
    {
      "time": 29.2,
      "text": "Mi gi' up likkle pride in di small tings"
    },
    {
      "time": 31.5,
      "text": "Pass off di chores, watch big dream spread wings"
    },
    {
      "time": 33.8,
      "text": "Some tings mi delegate, some tings mi elevate"
    },
    {
      "time": 36.1,
      "text": "Time weh mi give up, dat a time weh mi generate"
    },
    {
      "time": 38.4,
      "type": "section",
      "text": "[Chorus]"
    },
    {
      "time": 39.4,
      "text": "Mi trade you my hands, tek back my mind (yeah)"
    },
    {
